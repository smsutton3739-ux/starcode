# Copy to .env and adjust. Everything here has a working default for local development.

# ---- Core -------------------------------------------------------------------------
ENVIRONMENT=development
# Generate a real one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# The app refuses to start in production while this is the development sentinel.
SECRET_KEY=dev-only-insecure-change-me

# ---- AI ---------------------------------------------------------------------------
# Optional. Without a key the platform runs its deterministic engine: extraction,
# calendars and astronomy work fully, and the interpretive sections report themselves
# as unavailable rather than being filled with generated-looking text.
ANTHROPIC_API_KEY=
# auto | anthropic | offline
AI_PROVIDER=auto
AI_MODEL=claude-opus-5

# ---- Database and cache -----------------------------------------------------------
POSTGRES_USER=starcode
POSTGRES_PASSWORD=starcode
POSTGRES_DB=starcode
POSTGRES_PORT=5432
REDIS_PORT=6379

# ---- Accounts ---------------------------------------------------------------------
# Off by default: there is no password-reset flow, and an account nobody can recover is
# worse than no account. Anonymous use and OAuth both work without it, and OAuth
# verifies the email address as a side effect.
#
# The first administrator is created out of band, which is the one thing this setting
# would otherwise make impossible:
#
#   cd backend && python3 scripts/create_admin.py --email you@example.com
#
# That account signs in normally whatever this is set to.
ALLOW_PASSWORD_REGISTRATION=false
# The homepage must work with no account at all.
ALLOW_ANONYMOUS_ANALYSIS=true

# ---- URLs -------------------------------------------------------------------------
# NEXT_PUBLIC_API_URL is baked into the browser bundle at build time and must match the
# API's CORS_ORIGINS and the frontend middleware's CSP connect-src.
API_PORT=8000
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000
FRONTEND_BASE_URL=http://localhost:3000
OAUTH_REDIRECT_BASE=http://localhost:8000

# ---- Chart tools embed (optional) ---------------------------------------------------
# Affiliate ID for the Astro·Charts widgets on /tools. Leave empty and the page explains
# that the tools are not configured rather than embedding a placeholder.
#
# Read at frontend BUILD time, like every NEXT_PUBLIC_* value, so changing it needs a
# rebuild rather than a restart. The widgets are confined to /tools: their origin is
# allowed in frame-src on that route only, so a third-party script never runs on a page
# holding someone's submitted text or saved analyses.
NEXT_PUBLIC_ASTRO_CHARTS_AFF=

# ---- OAuth (optional) -------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---- Operational ------------------------------------------------------------------
LOG_FORMAT=console
LOG_LEVEL=INFO
SEED_ON_START=true


# ====================================================================================
# Production — one server, real domain
# ====================================================================================
# Used by deploy/docker-compose.prod.yml. Uncomment, fill in, and start with:
#
#   docker compose -f docker-compose.yml -f deploy/docker-compose.prod.yml up -d --build
#
# Step-by-step instructions are in docs/GO_LIVE.md.
#
#   DOMAIN=www.astro-decoded.com        # the site
#   APEX_DOMAIN=astro-decoded.com       # redirected to DOMAIN
#   API_DOMAIN=api.astro-decoded.com    # the API
#   ACME_EMAIL=you@example.com          # certificate-expiry warnings
#
#   SECRET_KEY=<python3 -c "import secrets; print(secrets.token_urlsafe(48))">
#   POSTGRES_PASSWORD=<openssl rand -base64 24>
#
# Nothing else needs setting. The overlay derives every URL below from DOMAIN and
# API_DOMAIN, because these five must agree exactly and deriving them removes the most
# common way a deployment breaks:
#
#   NEXT_PUBLIC_API_URL=https://api.astro-decoded.com     # frontend BUILD time
#   CORS_ORIGINS=https://www.astro-decoded.com            # backend runtime
#   FRONTEND_BASE_URL=https://www.astro-decoded.com       # used to build share links
#   OAUTH_REDIRECT_BASE=https://api.astro-decoded.com     # OAuth callback base
#   TRUSTED_HOSTS=api.astro-decoded.com
#
# NEXT_PUBLIC_API_URL is compiled into the browser bundle, so changing it needs a
# rebuild, not a restart.
#
# Note: https://www.astro-decoded.com and https://astro-decoded.com are DIFFERENT
# origins for CORS. www is canonical here and the apex redirects to it; only the
# canonical one is ever listed in CORS_ORIGINS.
#
# Deploying the two halves to separate managed hosts instead (Vercel + Railway, say)?
# Set the five values above by hand there — see docs/GO_LIVE.md, Path 2.
